# 复制为 .env 后填写。.env 不会提交到 GitHub。

# ---- 火山方舟（Seedream 4.0 生图 / DeepSeek V4.1 Flash 分镜 / Seedance 2.0 mini 视频，共用一个 Key）----
ARK_API_KEY=
# 模型 ID 会随版本更新，以方舟控制台「模型广场」里显示的为准；也可以填自建的推理接入点 ep-xxxx
ARK_IMAGE_MODEL=doubao-seedream-4-0-20260415
ARK_LLM_MODEL=deepseek-v4-1-flash-260910
ARK_VIDEO_MODEL=doubao-seedance-2-0-mini-260615
ARK_VIDEO_RESOLUTION=720p
# ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# ---- 可选：分镜改用 DeepSeek 官方平台（platform.deepseek.com 的 sk- 开头 Key），填了就不再用方舟的 ARK_LLM_MODEL ----
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# ---- 可灵（精品档视频：2.5 Turbo 1080p），在可灵开放平台创建 AccessKey / SecretKey ----
KLING_ACCESS_KEY=
KLING_SECRET_KEY=
KLING_MODEL=kling-v2-5-turbo
KLING_MODE=pro
# KLING_BASE_URL=https://api-beijing.klingai.com

# ---- 服务 ----
PORT=8787
# 部署到公网前务必设置：设置后打开网页需要输入这个口令，防止别人消耗你的模型额度
ACCESS_TOKEN=
# 生成的图片和视频保存位置
DATA_DIR=data
# 调用模型接口的超时时间（毫秒），默认 3 分钟
# UPSTREAM_TIMEOUT_MS=180000
